# AI backend: choose how the bot talks to an LLM.
#   "api"        -> Anthropic Messages API (default, needs ANTHROPIC_API_KEY)
#   "agent"      -> Claude Agent SDK / Claude Code engine (needs ANTHROPIC_API_KEY
#                   + pip install -e ".[agent]" + Claude Code CLI on PATH)
#   "openrouter" -> OpenRouter (OpenAI-compatible, e.g. Google Gemini Flash;
#                   needs OPENROUTER_API_KEY)
AI_BACKEND=api

# OpenRouter (used when AI_BACKEND=openrouter)
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_MODEL=google/gemini-2.5-flash-lite

# Anthropic (used when AI_BACKEND=api or agent)
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-sonnet-4-20250514

# LinkedIn
LINKEDIN_EMAIL=your@email.com
LINKEDIN_PASSWORD=your_password

# Application settings
MAX_DAILY_APPLICATIONS=50
DELAY_MIN=5
DELAY_MAX=15
APPLICATIONS_PER_SESSION=20

# Proxy (optional)
PROXY_URL=

# Database
DATABASE_URL=sqlite:///data/botlinkedin.db

# Web dashboard
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8000

# Logging
LOG_LEVEL=INFO
