# Anthropic
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-sonnet-4-20250514
# AI backend: "api" (direct Messages API, default) or "agent" (Claude Agent SDK).
# The "agent" backend routes generation through the Claude Code engine and still
# authenticates with your ANTHROPIC_API_KEY above. It requires the optional deps
# (pip install -e ".[agent]") and the Claude Code CLI on your PATH.
AI_BACKEND=api

# LinkedIn
LINKEDIN_EMAIL=your@email.com
LINKEDIN_PASSWORD=your_password

# Application settings
MAX_DAILY_APPLICATIONS=50
DELAY_MIN=5
DELAY_MAX=15
APPLICATIONS_PER_SESSION=20

# Proxy (optional)
PROXY_URL=

# Database
DATABASE_URL=sqlite:///data/botlinkedin.db

# Web dashboard
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8000

# Logging
LOG_LEVEL=INFO
